# Pandora dialogue 服务生产配置样例(2026-06-16)。复制为 dialogue-prod.yaml 后按环境填值。
#
# - gRPC :20013 / HTTP :21013(仅 /metrics)
# - prod: enable_reflection 不写(零值 false)= 关闭 grpc reflection
#
# 对话树来自配置表(源表 对话/d_对话.xlsx),已按 §9.15 走标准热更流水线;
# 改文案 = 改表 + 重发批次 + ReloadConfigTable,不改本文件、不重启。
#
# 阶段限制:会话仍是单实例内存。生产若多实例,需把 SessionStore 换 Redis 版
# (biz / service 不动);在那之前 prod 单实例运行。

server:
  grpc:
    network: tcp
    addr: ":20013"
    timeout: "5s"
    # enable_reflection 省略 = 关闭(prod 默认)
  http:
    network: tcp
    addr: ":21013"

node:
  node_id: 1

# 对话树唯一权威(与 UE 同源的发布批次目录)。留空拒启,不存在「没配就没有对话」这条路。
config_table:
  dir: "/app/configtable/active"

dialogue:
  session_ttl: "5m"
