# Pandora trade 服务生产配置模板(2026-06-16)。
#
# 真实部署时复制为 trade-prod.yaml 并按集群实际地址 / 密码填写,**不要提交真实密码到 git**。
# - gRPC :50012 / HTTP :51012(仅 /metrics)
# - prod: enable_reflection 不写(零值 false,关 reflection 减少攻击面)

server:
  grpc:
    network: tcp
    addr: ":50012"
    enable_rate_limit: true   # 压测前审核门禁-A:BBR 自适应限流(客户端面服务 prod 必开,过载按 CPU/inflight/RT 丢负载)
    timeout: "3s"
  http:
    network: tcp
    addr: ":51012"

node:
  node_id: 1
  redis_client:
    host: "redis:6379"
    password: "__REPLACE_WITH_SECRET__"
    db: 0
    dial_timeout: "2s"
    read_timeout: "1s"
    write_timeout: "1s"

kafka:
  brokers: ["kafka:9092"]
  dial_timeout: "2s"
  write_timeout: "5s"
  idempotent: true

snowflake:
  epoch: 1773446400
  node_bits: 17
  step_bits: 15

trade:
  order_ttl: "10m"
  order_expire: "5m"
  optimistic_retry: 3
  max_items_per_order: 20

# 会话现行性门(R5 复审 P0-1,INC-20260722-004):生产强制档,顶号后旧 JWT 立即失效;
# 权威端点漏配拒启,权威不可达 fail-closed。与 gen_cluster_config.ps1 -Prod 产物一致。
session_gate:
  require: true
