# Pandora battle_result 生产配置【模板】。cp battle_result-prod.yaml.example battle_result-prod.yaml 填真值后部署。
# ⚠️ 真实 battle_result-prod.yaml 被 services/.gitignore 忽略,只提交本 .example。
# 本模板固定 Model-B：同步 ReportResult 经 DS callback Guard + Redis active 校验；
# pandora.battle.result 旧 Kafka 消息没有可核验实例凭据，生产禁止订阅。
# 与 dev 差异:删 enable_reflection;timeout 收紧;mysql/redis 强密码;kafka 真实 brokers；
#            player_addr 走 k8s service DNS；DS authority fence 必须已 bootstrap。

server:
  grpc:
    network: tcp
    addr: ":20022"
    timeout: "5s"
    # enable_reflection 不写 = false
  http:
    network: tcp
    addr: ":21022"

node:
  node_id: 1
  mysql_client:
    dsn: "pandora:__MYSQL_STRONG_PASSWORD__@tcp(__MYSQL_HOST__:3306)/pandora_battle?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_0900_ai_ci"
    max_open_conns: 64
    max_idle_conns: 16
    conn_max_lifetime: "30m"
    ping_timeout: "3s"
  redis_client:
    host: "__REDIS_HOST__:6379"
    password: "__REDIS_PASSWORD__"
    db: 0
    dial_timeout: "2s"
    read_timeout: "1s"
    write_timeout: "1s"

snowflake:
  epoch: 1773446400
  node_bits: 17
  step_bits: 15

kafka:
  brokers: ["__KAFKA_BROKER_1__:9092", "__KAFKA_BROKER_2__:9092"]
  group_id: "pandora-battle-result"
  partition_cnt: 4

# config_table: 策划配置表加载(不变量 §9.15;docs/design/config-table-hotreload.md)。
#   本服的 **dir 不可留空**:怪物击杀经验的唯一数值权威是 role_level 表
#   (源表 角色/j_角色等级.xlsx 的「击杀经验」列),缺表时每条击杀事实都会被
#   ReportProgress 按可重试错误退回,服务带病跑没有意义 —— 故启动即 fail-fast 退出。
#   dev 直接指仓库 dist(相对服务目录);部署环境用发布脚本落的 <deploy-root>/configtable/active。
#   热更走 ConfigTableAdminService.ReloadConfigTable,改完数值不必重启。
config_table:
  dir: "/app/configtable/active"
battle:
  elo_k_factor: 32                # 不变量 §6:MMR 在 battle_result 算(DS 不可信)
  base_mmr: 1500
  consume_topics:
    - "pandora.ds.lifecycle"
  player_addr: "player.pandora.svc.cluster.local:20002"
  matchmaker_addr: "matchmaker.pandora.svc.cluster.local:20011"
  ds_allocator_addr: "ds-allocator.pandora.svc.cluster.local:20020"
  terminal_release_interval: "2s"
  terminal_release_batch_size: 128
  terminal_release_grace: "15s"
  outbox_publish_interval: "2s"   # 不变量 §4:player.update 事务出箱 at-least-once
  outbox_batch_size: 128

  # ── 战斗中实时进度通道(实时成长,realtime-progression.md)────────────────────
  # 缺省 false=关闭(新对局拒开流,DS 自动走局后结算路径;已开流对局不受影响)。
  # ⚠️ 启用纪律(P0 级,不变量 §21 混版安全):必须先把 battle_result **全部副本**升级到
  # 含实时进度收口逻辑的版本(≥2026-07-21,启动日志有 battle_progress schema gate),
  # 且 pandora_player 000002+000003 / pandora_battle 000005+000006+000007+000008 迁移
  # 已全绿(000006 单玩家累计表与 000008 停流标记列是启动 schema gate 的强依赖),
  # 再置 true 滚动下发。
  # 旧代码副本结算不感知水位表、不抑制结算掉落 —— 提前打开会在混版窗口双发掉落。
  # 回滚:置 false 只停新对局开流,进行中对局继续收流到结算,不丢已入账产出。
  progress_enabled: false
  # 怪物击杀经验**不在本文件配置**：数值权威是策划表 角色/j_角色等级.xlsx 的「击杀经验」列，
  # 经 configtable 的 role_level 表按 (角色ID, 等级) 查（见下方 config_table.dir）。
  # 2026-08-04 从本文件移除：游戏数值住在服务配置里，策划改不了、与同一只怪的血/攻分家、
  # ID 一致性也没有任何机制保证（实测漏配过 2007 蛇怪 / 2008 剧毒蛇怪且长期无人发现）。
  # 残留的 monster_exp 键会被严格解析直接拒绝启动，不会静默忽略。
  max_progress_exp_per_match: 1000000
  max_progress_items_per_match: 500

  # ── 战报保留期(§9.24 登记例外:180 天)──────────────────────────────────
  # 产品口径:MySQL 里最多只存最近六个月的战报,超过六个月的就没有数据
  # (2026-08-03 用户指令)。同一个值也是玩家战报可见窗口(ListPlayerHistory 只读
  # MySQL,没有冷存归档);要给运营/客服留更久必须另做归档,不是加大这个数。
  # 取值钳在 [30,180];想留更长要同时改 conf.HistoryRetentionMaxDays、CLAUDE.md §9.24
  # 登记表和 budgets.go 容量预算,不允许靠配置静默突破。
  history_retention_days: 180
  # ⚠️ 本服 retention_mode 留空即 **delete**(真删),与其它域 report_only 默认相反。
  # 首次上线纪律:开删前先跑 `dbcheck -pending` 看待清理规模 —— 存量库第一轮会把
  # 全部超期积压按 200 场/批循环删完(批间独立短事务不锁表,但会持续压 DB 一段时间),
  # 建议低峰期发布。排查误删嫌疑时改 report_only 立即停删(只统计打 WARN)。
  retention_mode: "delete"
  retention_sweep_interval: "1h"
  retention_sweep_batch: 200

# Model-B 回调身份与玩家 SessionToken / DSTicket 完全分域。battle-result 只持有 DS callback
# verifier 材料，不持有任何玩家签票私钥；普通 stable/canary 发布不轮换本 secret/keyset。
ds_auth:
  mode: "enforce"
  authority_mode: "redis"
  issuer: "pandora-ds-control"
  audience: "pandora-ds"
  active_heartbeat_max_age: "30s"
  secret: "__DS_CALLBACK_HS256_SECRET_AT_LEAST_32_BYTES__"
  fence:
    etcd_endpoints: ["__ETCD_ENDPOINT_1__:2379", "__ETCD_ENDPOINT_2__:2379"]
    etcd_prefix: "/pandora/ds-auth/"
    etcd_lease_ttl_sec: 15
    etcd_dial_timeout: "5s"
    keyset_revision: "__IMMUTABLE_DS_AUTH_KEYSET_REVISION__"
