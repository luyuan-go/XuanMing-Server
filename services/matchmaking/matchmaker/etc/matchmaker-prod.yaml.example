# Pandora matchmaker 生产配置【模板】。cp matchmaker-prod.yaml.example matchmaker-prod.yaml 填真值后部署。
# ⚠️ 真实 matchmaker-prod.yaml 被 services/.gitignore 忽略,只提交本 .example。
# 与 dev 差异:删 enable_reflection;timeout 收紧;redis 加密码;kafka 真实 brokers;
#            服务间地址走 k8s service DNS;jwt 强随机 secret(与 login/envoy/hub_allocator 一致)。

server:
  grpc:
    network: tcp
    addr: ":20011"
    enable_rate_limit: true   # 压测前审核门禁-A:BBR 自适应限流(客户端面服务 prod 必开,过载按 CPU/inflight/RT 丢负载)
    # 普通玩家 RPC 上限。ConfirmMatch 只持久 CAS ALLOCATING；AllocateBattle 由服务生命周期
    # durable worker 使用独立有界 ctx 推进，不能继承玩家断线/请求取消。
    timeout: "22s"
    # enable_reflection 不写 = false
  http:
    network: tcp
    addr: ":21011"

node:
  node_id: 1
  redis_client:
    host: "__REDIS_HOST__:6379"
    password: "__REDIS_PASSWORD__"
    db: 0
    dial_timeout: "2s"
    read_timeout: "1s"
    write_timeout: "1s"

kafka:
  brokers: ["__KAFKA_BROKER_1__:9092", "__KAFKA_BROKER_2__:9092"]
  dial_timeout: "2s"
  write_timeout: "5s"
  idempotent: true

snowflake:
  epoch: 1773446400
  node_bits: 17
  step_bits: 15

# config_table: 策划配置表加载(不变量 §9.15;docs/design/config-table-hotreload.md §4)。
# 生产指向发布脚本维护的 active 目录;启动强依赖,加载失败进程退出(fail-closed)。
config_table:
  dir: "/data/pandora/configtable/active"

match:
  team_addr: "team.pandora.svc.cluster.local:20010"
  ds_allocator_addr: "ds-allocator.pandora.svc.cluster.local:20020"
  locator_addr: "player-locator.pandora.svc.cluster.local:20006"
  # 独立 Login→Matchmaker 服务身份 key；不得复用 JWT / DS callback key。
  match_resume_auth_secret: "__MATCH_RESUME_AUTH_SECRET_32B__"
  match_resume_auth_audience: "matchmaker:5v5_ranked"
  # Team→Matchmaker 读同一个 ResolvePlayerMatchContext(入队闸门 + 招募列表复核),
  # 但持有**另一把**独立 key：共用一把等于 login 与 team 的信任域合并(任一方可冒充另一方),
  # 且轮换变成全有全无。必须等于 team 的 team.match_resume_auth_secret。
  # 留空不会回落到 login 那把：team 会被 matchmaker 拒(code=7) ⇒ 入队 fail-closed、招募列表恒空。
  team_resume_auth_secret: "__TEAM_RESUME_AUTH_SECRET_32B__"
  allocation_abort_auth_secret: "__ALLOCATION_ABORT_AUTH_SECRET_32B__"
  allocation_abort_auth_audience: "ds-allocator:battle-allocation-abort"
  # liveness_gate_enabled: locator 在线判定两道门(队列扫死票 livenessSweep + 成局最终门 findOfflineMembers)。
  # ❗ INC-20260724-001 后回退为 false(= conf.go 代码默认值)。2026-07-08 验证的 HUB 态续期链有效,
  # 但成局最终门查的是 MATCHING(=4) 态成员,该态既无续期写者也无释放通道(仅 state==3 会被
  # RefreshHubLocations 续期) ⇒ 成局超过 locator TTL(30s)后全员必然假阳性判死;且 MATCHING key
  # 过期后无法重建,该玩家再排队的票据也会被 livenessSweep 误删。故两道门一起关。
  # 重开前置与决策待办见 matchmaker-dev.yaml 同项注释 + 事故档 D2。
  liveness_gate_enabled: false
  map_id: 1
  game_mode: "5v5_ranked"
  confirm_timeout: "15s"
  match_interval: "2s"
  ticket_ttl: "30m" # 仅显式终态后的留存；非终态 ticket/claim 持久
  match_ttl: "30m"  # 仅显式终态后的留存；非终态 match 持久
  team_size: 5
  mmr_base_window: 200
  mmr_widen_per_sec: 20
  mmr_max_window: 2000
  optimistic_retry: 3
  # leader: 后台撮合循环单写者选举(P0 修复 2026-07-15,codex P0-14)。
  # ⚠️ 生产默认开启:副本数 >1 而未开选举 = 双写者并发推进同一 match saga,
  # WATCH/CAS 只防单键竞态,防不了跨键 saga 交错(重复成局/重复分配 DS)。
  # 单副本部署开着也无害(唯一副本自动当选)。与 deploy/k8s/services/services.yaml
  # 的 matchmaker replicas 约束配套。
  leader:
    enabled: true
    etcd_endpoints: ["etcd.pandora.svc.cluster.local:2379"]
    prefix: "/pandora/prod/leader/"
    lease_ttl_sec: 10

jwt:
  issuer: "pandora-login"
  audience: "pandora-client"
  # ⚠️ 必须与 login / envoy / hub_allocator 完全一致;≥32 字节强随机
  secret: "__JWT_SHARED_SECRET_32B_CHANGE_ME__"
  session_ttl: "24h"
  ds_ticket_ttl: "5m"

# 会话现行性门(R5 复审 P0-1,INC-20260722-004):生产强制档,顶号后旧 JWT 立即失效;
# 权威端点漏配拒启,权威不可达 fail-closed。与 gen_cluster_config.ps1 -Prod 产物一致。
session_gate:
  require: true
