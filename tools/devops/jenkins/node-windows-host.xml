<?xml version="1.1" encoding="UTF-8"?>
<slave>
  <name>windows-host</name>
  <description>Windows 宿主机构建代理（UE 打包 / DS 镜像）。由 tools/devops 接线。</description>
  <remoteFS>@@AGENT_WORKDIR@@</remoteFS>
  <!-- 2 个执行器：客户端 UE 打包一次跑 4~5 小时，单执行器会把所有后端构建
       全堵在它后面，后端 CI 形同虚设。实测 UE 编译期间 20 逻辑核 CPU 仅 ~23%，
       并行一个 Go 构建不会互相拖垮。两个任务各自有独立工作区，且都开了
       DisableConcurrentBuilds，不存在同任务并发写同一目录的问题。
       再往上加要先测内存：UE 链接阶段是内存峰值。 -->
  <numExecutors>2</numExecutors>
  <mode>NORMAL</mode>
  <retentionStrategy class="hudson.slaves.RetentionStrategy$Always"/>
  <launcher class="hudson.slaves.JNLPLauncher">
    <workDirSettings>
      <disabled>false</disabled>
      <internalDir>remoting</internalDir>
      <failIfWorkDirIsMissing>false</failIfWorkDirIsMissing>
    </workDirSettings>
    <webSocket>true</webSocket>
  </launcher>
  <label>windows</label>
  <nodeProperties>
    <hudson.slaves.EnvironmentVariablesNodeProperty>
      <envVars serialization="custom">
        <unserializable-parents/>
        <tree-map>
          <default>
            <comparator class="hudson.util.CaseInsensitiveComparator"/>
          </default>
          <int>3</int>
          <string>LINUX_MULTIARCH_ROOT</string>
          <string>@@LINUX_MULTIARCH_ROOT@@</string>
          <string>PANDORA_ARTIFACT_ROOT</string>
          <string>@@PANDORA_ARTIFACT_ROOT@@</string>
          <string>PANDORA_PROTO_SERVER_ROOT</string>
          <string>@@PANDORA_PROTO_SERVER_ROOT@@</string>
        </tree-map>
      </envVars>
    </hudson.slaves.EnvironmentVariablesNodeProperty>
  </nodeProperties>
</slave>