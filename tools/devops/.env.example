# ── Pandora DevOps 栈配置（每台机器一份，复制为 .env 后按需改）──
# up.ps1 会在缺 .env 时自动从本文件生成。改端口/口令只改这里，别改 compose。
# 生产/共享环境务必改掉下面所有默认口令。

# ── Jenkins ──
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-admin
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_PUBLIC_URL=http://localhost:8080/

# ── 镜像 registry ──
REGISTRY_PORT=5000
REGISTRY_UI_PORT=8082

# ── MinIO 制品对象存储 ──
MINIO_ROOT_USER=pandora
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=pandora-artifacts
MINIO_EXPIRE_DAYS=30

# ── Nexus 通用制品库（可选 profile，默认不起；与 registry+MinIO 职责重叠）──
NEXUS_PORT=8081

# ── Jenkins 接线（setup-jenkins.ps1 用）──
# 换机器时按实际改这几项，然后跑 setup-jenkins.ps1 即可复现全部节点与任务。
BACKEND_GIT_URL=https://github.com/luyuan-go/XuanMing-Server.git
SVN_CLIENT_URL=http://infinity-svn/svn/Pandora-Moba/trunk/Client
# 后端 SVN 地址。团队权威源是 SVN(^/trunk/Server，与 ^/trunk/Client 同仓同级)，
# CI 必须构建它而不是任何人的个人 git 仓库。同仓同级意味着一个 revision 就能
# 同时定位前后端状态。
SVN_SERVER_URL=http://infinity-svn/svn/Pandora-Moba/trunk/Server
# Jenkins 里那条 SVN 凭据的 ID。凭据本身必须你在 Jenkins 界面自建（密码不经脚本）。
SVN_CREDENTIALS_ID=svn-cred
# 构建 agent 的工作目录（会放 agent.jar、日志和各任务工作区，需要几百 GB 空间）
AGENT_WORKDIR=F:\jenkins-agent
# 注入到构建节点的环境变量：UE 打包与制品发布都依赖它们
PANDORA_PROTO_SERVER_ROOT=F:\work\XuanMing-Server
PANDORA_ARTIFACT_ROOT=F:\work\artifacts
LINUX_MULTIARCH_ROOT=C:\UnrealToolchains\v26_clang-20.1.8-rockylinux8\

# ── 内网 SVN 主机名映射（Jenkins 容器用）──
# 容器不参与宿主机 mDNS/NetBIOS 解析：宿主机 ping 得通 infinity-svn，容器里照样解析失败，
# 表现为 SCM 轮询/拉 Jenkinsfile 时 HTTP 000。这里写死映射绕开。
# 换网段时改 IP；用命令确认当前值： Resolve-DnsName infinity-svn
SVN_HOST=infinity-svn
SVN_HOST_IP=192.168.2.254
